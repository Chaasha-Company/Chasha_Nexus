{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "ignoreDeprecations": "6.0",

    "baseUrl": ".",

    "moduleResolution": "bundler",

    "types": ["node"],

    "paths": {
      "@/*": ["src/*"]
    },

    "declaration": true,

    "sourceMap": true,
  },

  "include": ["src"],

  "exclude": ["dist", "node_modules"]
}
