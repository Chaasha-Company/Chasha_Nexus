  },
  "components": {
    "schemas": {
      "LoginWithUsernameInput": {
        "type": "object",
        "required": ["userUserName", "userPassword"],
        "properties": {
          "userUserName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 54,
            "description": "نام کاربری کاربر."
          },
          "userPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "description": "رمز عبور کاربر."
          }
        }
      },
      "CreateCounselRequestInput": {
        "type": "object",
        "required": ["counselRequestFullName", "counselRequestPhoneNumber", "counselRequestDescription", "counselRequestInformationId"],
        "properties": {
          "counselRequestFullName": {
            "type": "string",
            "description": "نام کامل فرد درخواست‌کننده مشاوره.",
            "example": "علی رضایی"
          },
          "counselRequestPhoneNumber": {
            "type": "string",
            "description": "شماره تلفن درخواست‌دهنده. باید با الگوهای استاندارد تلفن مطابقت داشته باشد.",
            "example": "09393929968"
          },
          "counselRequestDescription": {
            "type": "string",
            "maxLength": 120,
            "description": "توضیح مختصری درباره درخواست یا مشکل. حداکثر ۱۲۰ کاراکتر.",
            "example": "نیاز به کمک برای فرآیند تخلیه مستأجر دارم."
          },
          "counselRequestInformationId": {
            "type": "string",
            "maxLength": 36,
            "description": "شناسه ی برند",
            "example": "c2f8201c-26e2-4830-8b36-1cb557ec759a"
          }
        }
      },
      "CreateCounselGlobalResponseDTO": {
        "type": "object",
        "properties": {
          "counselRequestMessage": {
            "type": "string",
            "description": "پیام موفقیتی که توسط سیستم بازگردانده می‌شود."
          },
          "counselRequestCode": {
            "type": "string",
            "description": "کد منحصر به فرد اختصاص یافته به این درخواست خاص."
          }
        }
      },
      "ApiResponseSuccess": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "کد وضعیت HTTP"
          },
          "success": {
            "type": "boolean",
            "description": "نشان‌دهنده موفقیت عملیات"
          },
          "author": {
            "type": "string",
            "description": "نویسنده پاسخ API"
          },
          "message": {
            "type": "string",
            "description": "پیام توصیف‌کننده نتیجه"
          },
          "data": {
            "oneOf": [{ "$ref": "#/components/schemas/CreateCounselGlobalResponseDTO" }, { "type": "null" }],
            "nullable": true,
            "description": "داده‌های پاسخ یا null اگر داده خاصی بازگردانده نشود."
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time",
            "description": "زمان ثبت پاسخ"
          },
          "version": {
            "type": "string",
            "description": "نسخه API"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "کد وضعیت HTTP"
          },
          "success": {
            "type": "boolean",
            "description": "برای خطاها همیشه false است"
          },
          "author": {
            "type": "string",
            "description": "نویسنده پاسخ API"
          },
          "message": {
            "type": "string",
            "description": "پیام خطای عمومی"
          },
          "errorCode": {
            "type": "string",
            "description": "کد خطای خاص تعریف شده در enum ErrorCode"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "نقشه‌ای از نام فیلدها به آرایه‌ای از پیام‌های خطا"
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time",
            "description": "زمان ثبت پاسخ"
          },
          "version": {
            "type": "string",
            "description": "نسخه API"
          }
        }
      }
    }
  }
}
