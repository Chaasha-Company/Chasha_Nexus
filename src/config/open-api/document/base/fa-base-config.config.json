{
  "openapi": "3.1.0",
  "info": {
    "title": "پلتفرم چاشا - API رسمی",
    "summary": "مستندات رسمی REST API پلتفرم چاشا",
    "description": "این API موتور عملیاتی پلتفرم رستوران‌های چاشا را تغذیه می‌کند.\n\nاین API امکان مدیریت پلتفرم، مدیریت رستوران‌ها، احراز هویت، سفارش‌گیری، منوی QR، گردش کار آشپزخانه، اعلان‌ها و خدمات آینده پلتفرم را فراهم می‌کند.\n\nتمامی اندپوینت‌ها از اصول REST پیروی کرده و پاسخ‌های استاندارد JSON برمی‌گردانند.\n\nاحراز هویت بسته به پلتفرم کاربر (وب یا موبایل)، هم از طریق کوکی (Cookie-based) و هم از طریق توکن Bearer پشتیبانی می‌شود.",
    "version": "1.0.0",
    "termsOfService": "https://docs.chaasha.ir/terms",
    "contact": {
      "name": "شرکت کرا فناوری",
      "url": "https://karaflow.com",
      "email": "backend@karaflow.com"
    },
    "license": {
      "name": "مجوز خصوصی",
      "url": "https://docs.chaasha.ir/license"
    }
  },

  "externalDocs": {
    "description": "مستندات کامل توسعه‌دهندگان",
    "url": "https://docs.chaasha.ir"
  },

  "servers": [
    {
      "url": "https://api.chaasha.ir/api/v1",
