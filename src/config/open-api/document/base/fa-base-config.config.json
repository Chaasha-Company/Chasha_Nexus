{
  "openapi": "3.0.0",
  "info": {
    "title": "مستندات API بک‌اند چاشا",
    "version": "1.0.0",
    "description": "مستندات کامل API پلتفرم چاشا که توسط تیم توسعه کارا ایجاد شده است."
  },
  "servers": [
    {
      "url": "https://api.chaasha.ir/api/v1",
      "description": "سرور تولید (Production)",
      "variables": {
        "prefix": {
          "enum": ["fa", "en"],
          "default": "fa",
          "description": "پیشوند زبان"
        }
      }
    },
    {
      "url": "https://develop-api.chasha.ir/api/v1",
      "description": "سرور توسعه (Development)",
      "variables": {
        "prefix": {
          "enum": ["fa", "en"],
          "default": "fa",
          "description": "پیشوند زبان"
        }
      }
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "سرور محلی (Local)",
      "variables": {
        "prefix": {
          "enum": ["fa", "en"],
          "default": "fa",
          "description": "پیشوند زبان"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Auth - Login",
      "description": "نقاط پایانی مربوط به ورود کاربر و تولید توکن"
    },
    {
      "name": "Auth - Check",
      "description": "نقاط پایانی مربوط به بررسی وضعیت احراز هویت"
    },
    {
      "name": "GLOBAL - Counsel Request",
      "description": "نقاط پایانی مربوط به ایجاد و مدیریت درخواست‌های مشاوره"
    },
    {
      "name": "GLOBAL - Company Information",
      "description": "نقاط پایانی مربوط به دریافت اطلاعات حقوقی و تماس شرکت"
    }
  ],
  "paths": {
    "/global/auth/login/username": {
      "post": {
        "tags": ["Auth - Login"],
        "summary": "ورود با نام کاربری",
        "description": "احراز هویت کاربر با استفاده از نام کاربری و رمز عبور. پس از احراز هویت موفق، توکن‌های JWT به صورت کوکی‌های HttpOnly در پاسخ تنظیم می‌شوند.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginWithUsernameInput"
              },
              "example": {
                "userUserName": "عرفان_ابویی",
                "userPassword": "SecurePass123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ورود موفقیت‌آمیز بود. توکن‌ها در کوکی‌های HttpOnly تنظیم شدند.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                },
                "example": {
                  "status": 200,
                  "success": true,
                  "author": "Kara_Company",
                  "message": "عملیات با موفقیت انجام شد.",
                  "data": null,
                  "timeStamp": "2026-06-13T10:47:54.024Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "400": {
            "description": "درخواست نامعتبر - خطای اعتبارسنجی",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 400,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "اعتبارسنجی ناموفق بود",
                  "errorCode": "VALIDATION_ERROR",
                  "errors": {
                    "userUserName": ["نام کاربری الزامی است"],
                    "userPassword": ["رمز عبور باید حداقل ۸ کاراکتر باشد"]
                  },
                  "timeStamp": "2026-06-13T10:47:54.024Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "404": {
            "description": "یافت نشد - اطلاعات ورود اشتباه",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 404,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "موردی با این مشخصات پیدا نشد.",
                  "errorCode": "NOT_FOUND",
                  "errors": {
                    "details": ["نام کاربری یا رمز عبور اشتباه است."]
                  },
                  "timeStamp": "2026-06-13T10:47:54.024Z",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/global/user/auth/check": {
      "get": {
        "tags": ["Auth - Check"],
        "summary": "بررسی وضعیت احراز هویت کاربر",
        "description": "این نقطه پایانی بررسی می‌کند که آیا کاربر فعلی لاگین کرده است یا خیر. اگر کاربر معتبر باشد، یک پاسخ موفقیت‌آمیز با آبجکت داده خالی بازگردانده می‌شود. در غیر این صورت، خطای UNAUTHORIZED بازگردانده می‌شود.",
        "responses": {
          "200": {
            "description": "کاربر احراز هویت شده است. پاسخ موفقیت با داده خالی.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                },
                "example": {
                  "status": 200,
                  "success": true,
                  "author": "Kara_Company",
                  "message": "عملیات با موفقیت انجام شد.",
                  "data": {},
                  "timeStamp": "2026-06-13T10:47:54.024Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "401": {
            "description": "غیرمجاز - توکن نامعتبر یا موجود نیست",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 401,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "شما مجوز دسترسی به این منبع را ندارید.",
                  "errorCode": "UNAUTHORIZED",
                  "errors": {},
                  "timeStamp": "2026-06-13T10:47:54.024Z",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/global/counsel-request/create": {
      "post": {
        "tags": ["GLOBAL - Counsel Request"],
        "summary": "ایجاد درخواست مشاوره جدید",
        "description": "این نقطه پایانی به کاربران اجازه می‌دهد تا یک درخواست جدید برای خدمات مشاوره ارسال کنند. قبل از پردازش، نام کامل، شماره تلفن و توضیحات اعتبارسنجی می‌شوند.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCounselRequestInput"
              },
              "example": {
                "counselRequestFullName": "عرفان ابویی",
                "counselRequestPhoneNumber": "09393929968",
                "counselRequestDescription": "سلام و درود. بنده به دنبال یه اپلیکیشن فروشگاهی هستم و خواستار پیاده سازی اون توسط کارا هستم.",
                "counselRequestInformationId": "c2f8201c-26e2-4830-8b36-1cb557ec759a"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "درخواست مشاوره با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                },
                "example": {
                  "status": 201,
                  "success": true,
                  "author": "Kara_Company",
                  "message": "عملیات با موفقیت انجام شد",
                  "data": {
                    "counselRequestMessage": "درخواست شما ثبت و مشاوران ما در ساعات آینده با شما تماس خواهند گرفت",
                    "counselRequestCode": "@Kara_12345678"
                  },
                  "timeStamp": "2025-05-10T12:00:00.000Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "400": {
            "description": "درخواست نامعتبر - خطای اعتبارسنجی",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 400,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "اعتبارسنجی ناموفق بود",
                  "errorCode": "VALIDATION_ERROR",
                  "errors": {
                    "counselRequestFullName": ["نام کامل الزامی است"],
                    "counselRequestPhoneNumber": ["شماره تلفن معتبر الزامی است"]
                  },
                  "timeStamp": "2025-05-10T12:00:00.000Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "404": {
            "description": "یافت نشد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 404,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "موردی با این مشخصات پیدا نشد.",
                  "errorCode": "NOT_FOUND",
                  "errors": {
                    "routePath": ["/a123"],
                    "routeMethod": ["GET"]
                  },
                  "timeStamp": "2026-05-11T13:42:15.352Z",
                  "version": "1.0.0"
                }
              }
            }
          },
          "500": {
            "description": "خطای داخلی سرور",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "status": 500,
                  "success": false,
                  "author": "Kara_Company",
                  "message": "خطای داخلی سرور",
                  "errorCode": "INTERNAL_ERROR",
                  "errors": {},
                  "timeStamp": "2025-05-10T12:00:00.000Z",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
