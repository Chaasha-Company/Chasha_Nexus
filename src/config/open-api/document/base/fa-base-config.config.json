        "properties": {
          "error_message": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "error_message": ["اعتبارسنجی قانون کسب‌وکار ناموفق بود."]
        }
      },

      "ErrorResponse": {
