            "example": "اعتبارسنجی ناموفق بود."
          },
          "errorCode": {
            "type": "string",
            "example": "E1001"
          },
          "errors": {
            "type": "object",
            "description": "خطاهای اعتبارسنجی یا خطاهای کسب‌وکار."
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },

        "ValidationError": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
