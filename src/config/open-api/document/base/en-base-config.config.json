{
  "openapi": "3.1.0",
  "info": {
    "title": "Chasha Platform API",
    "summary": "Official REST API Documentation for Chasha Platform",
    "description": "The official REST API powering the Chasha Restaurant Operating System.\n\nThis API enables platform administration, restaurant management, authentication, ordering, QR menu, kitchen workflow, notifications, and future platform services.\n\nAll endpoints follow REST principles and return standardized JSON responses.\n\nAuthentication supports both Cookie-based and Bearer Token authorization depending on client platform.",
    "version": "1.0.0",
    "termsOfService": "https://docs.chaasha.ir/terms",
    "contact": {
      "name": "Kara Technology",
      "url": "https://karaflow.com",
      "email": "backend@karaflow.com"
    },
    "license": {
      "name": "Private License",
      "url": "https://docs.chaasha.ir/license"
    }
  },

  "externalDocs": {
    "description": "Complete Developer Documentation",
    "url": "https://docs.chaasha.ir"
  },

  "servers": [
    {
      "url": "https://api.chaasha.ir/api/v1",
      "description": "Production Server"
    },
    {
      "url": "https://staging-api.chaasha.ir/api/v1",
      "description": "Staging Server"
    },
    {
      "url": "https://develop-api.chaasha.ir/api/v1",
      "description": "Development Server"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development"
    }
