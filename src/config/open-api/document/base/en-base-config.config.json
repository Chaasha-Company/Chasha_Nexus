{
  "openapi": "3.1.0",
  "info": {
    "title": "Chasha Platform API",
    "summary": "Official REST API Documentation for Chasha Platform",
    "description": "The official REST API powering the Chasha Restaurant Operating System.\n\nThis API enables platform administration, restaurant management, authentication, ordering, QR menu, kitchen workflow, notifications, and future platform services.\n\nAll endpoints follow REST principles and return standardized JSON responses.\n\nAuthentication supports both Cookie-based and Bearer Token authorization depending on client platform.",
    "version": "1.0.0",
    "termsOfService": "https://docs.chaasha.ir/terms",
    "contact": {
      "name": "Kara Technology",
      "url": "https://karaflow.com",
      "email": "backend@karaflow.com"
    },
    "license": {
      "name": "Private License",
      "url": "https://docs.chaasha.ir/license"
    }
  },

  "externalDocs": {
    "description": "Complete Developer Documentation",
    "url": "https://docs.chaasha.ir"
  },

  "servers": [
    {
      "url": "https://api.chaasha.ir/api/v1",
      "description": "Production Server"
    },
    {
      "url": "https://staging-api.chaasha.ir/api/v1",
      "description": "Staging Server"
    },
    {
      "url": "https://develop-api.chaasha.ir/api/v1",
      "description": "Development Server"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development"
    }
  ],

  "tags": [
    {
      "name": "Platform Admin Authentication",
      "description": "Authentication endpoints for Platform Administrators including login, OTP verification, token generation, logout, refresh token and password recovery."
    }
  ],

  "paths": {
    "/admin/auth/login/with-phone": {
      "post": {
        "tags": ["Platform Admin Authentication"],
        "summary": "Login with phone number",
        "description": "Starts the Platform Administrator authentication process.\n\nThis endpoint validates the administrator credentials (phone number and password).\n\nIf the credentials are valid:\n- Creates a temporary login session.\n- Generates a six-digit OTP.\n- Stores the session in cache.\n- Returns a temporary loginSession identifier.\n\nThe returned loginSession must be used during OTP verification.\n\nIf there is already an active login session for this phone number, the API returns an error asking the client to continue the existing verification process instead of creating a new one.",
        "operationId": "loginWithPhoneNumberPlatformAdmin",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginWithPhoneNumberPlatformAdminRequest"
              },
              "examples": {
                "login": {
                  "summary": "Valid request",
                  "value": {
                    "loginPhoneNumber": "09123456789",
                    "loginPassword": "StrongPassword123"
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Login session created successfully.",
            "headers": {
              "x-request-id": {
                "description": "Unique request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginWithPhoneNumberPlatformAdminResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Session Created",
                    "value": {
                      "status": 200,
                      "success": true,
                      "author": "Kara_Company",
                      "message": "Operation completed successfully.",
                      "data": {
                        "loginSession": "2a8e43dc-be17-4d02-8820-daa3638168b1"
                      },
                      "timeStamp": "2026-07-28T19:01:15.281Z",
                      "version": "0.1.0"
                    }
                  }
                }
              }
            }
          },

          "400": {
            "description": "Validation failed or business rule violation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidPhoneNumber": {
                    "summary": "Phone Number Validation",
                    "value": {
                      "status": 400,
                      "success": false,
                      "author": "Kara_Company",
                      "message": "Validation failed.",
                      "errorCode": "E1001",
                      "errors": {
                        "loginPhoneNumber": ["Phone number must contain exactly 11 digits and start with 09."]
                      },
                      "timeStamp": "2026-07-28T19:01:46.652Z",
                      "version": "0.1.0"
                    }
                  },

                  "WrongPassword": {
                    "summary": "Incorrect Password",
                    "value": {
                      "status": 400,
                      "success": false,
                      "author": "Kara_Company",
                      "message": "Data conflict.",
                      "errorCode": "E1090",
                      "errors": {
                        "loginPassword": ["Password is incorrect."]
                      },
                      "timeStamp": "2026-07-28T19:01:22.197Z",
                      "version": "0.1.0"
                    }
                  },

                  "AlreadyInQueue": {
                    "summary": "Existing Login Session",
                    "value": {
                      "status": 400,
                      "success": false,
                      "author": "Kara_Company",
                      "message": "Data conflict.",
                      "errorCode": "E1090",
                      "errors": {
                        "error_message": ["Your login request is already in progress. Please return to the verification page and enter your OTP."]
                      },
                      "timeStamp": "2026-07-28T19:01:22.197Z",
                      "version": "0.1.0"
                    }
                  }
                }
              }
            }
          },

          "404": {
            "description": "Platform administrator not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFound": {
                    "value": {
                      "status": 404,
                      "success": false,
                      "author": "Kara_Company",
                      "message": "Requested resource was not found.",
                      "errorCode": "E1020",
                      "errors": {
                        "loginPhoneNumber": ["Platform administrator with this phone number does not exist."]
                      },
                      "timeStamp": "2026-07-28T19:01:27.765Z",
                      "version": "0.1.0"
                    }
                  }
                }
              }
            }
          },

          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Access Token"
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "HttpOnly Cookie Authentication"
      }
    },

    "schemas": {
      "LoginWithPhoneNumberPlatformAdminRequest": {
        "type": "object",
        "required": ["loginPhoneNumber", "loginPassword"],
        "properties": {
          "loginPhoneNumber": {
            "type": "string",
            "description": "Platform administrator phone number.",
            "example": "09123456789",
            "pattern": "^09\\d{9}$",
            "minLength": 11,
            "maxLength": 11
          },
          "loginPassword": {
            "type": "string",
            "description": "Platform administrator password.",
            "example": "StrongPassword123",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },

      "LoginWithPhoneNumberPlatformAdminResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "author": {
            "type": "string",
            "example": "Kara_Company"
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully."
          },
          "data": {
            "type": "object",
            "properties": {
              "loginSession": {
                "type": "string",
                "format": "uuid",
                "description": "Temporary login session identifier.",
                "example": "2a8e43dc-be17-4d02-8820-daa3638168b1"
              }
            }
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      },

      "ValidationError": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "loginPhoneNumber": ["Phone number must contain exactly 11 digits and start with 09."]
        }
      },

      "BusinessError": {
        "type": "object",
        "properties": {
          "error_message": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "error_message": ["Your login request is already in progress. Please return to the verification page and enter your OTP."]
        }
      },

      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 400
          },
          "success": {
            "type": "boolean",
            "example": false
          },
          "author": {
            "type": "string",
            "example": "Kara_Company"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "example": "E1001"
          },
          "errors": {
            "type": "object",
            "description": "Validation or business errors."
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      }
    },

    "responses": {
      "ValidationFailed": {
        "description": "Validation failed."
      },

      "BadRequest": {
        "description": "Business rule violation."
      },

      "Unauthorized": {
        "description": "Unauthorized."
      },

      "Forbidden": {
        "description": "Forbidden."
      },

      "NotFound": {
        "description": "Resource not found."
      },

      "Conflict": {
        "description": "Data conflict."
      },

      "TooManyRequests": {
        "description": "Too many requests."
      },

      "InternalServerError": {
        "description": "Internal Server Error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": 500,
              "success": false,
              "author": "Kara_Company",
              "message": "Internal Server Error.",
              "errorCode": "E5000",
              "errors": {},
              "timeStamp": "2026-07-28T19:01:46.652Z",
              "version": "0.1.0"
            }
          }
        }
      }
    }
  },

  "security": [
    {
      "CookieAuth": []
    },
    {
      "BearerAuth": []
    }
  ]
}
