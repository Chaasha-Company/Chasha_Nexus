{
  "name": "chasha-platform",
  "version": "1.0.0",
  "description": "Chasha is a modern Restaurant Operating System founded by Erfan Abouei under Kara Holding. Chasha helps restaurants and cafes optimize their operations by providing digital menus, QR-based ordering, real-time order management, and a seamless experience for customers, waiters, and restaurant teams.",
  "keywords": [
    "Restaurant",
    "RestaurantOS",
    "RestaurantManagement",
    "DigitalMenu",
    "QROrdering",
    "OnlineMenu",
    "TableOrdering",
    "HospitalityTechnology",
    "CafeManagement",
    "FoodTechnology",
    "RealtimeOrdering",
    "ModernRestaurant",
    "CustomerExperience",
    "KaraHolding"
  ],
  "homepage": "https://github.com/Erfan-Abouei/Chasha_Platform#readme",
  "bugs": {
    "url": "https://github.com/Erfan-Abouei/Chasha_Platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erfan-Abouei/Chasha_Platform.git"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "license": "ISC",
  "author": "Erfan-Abouei",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:production": "vite build && npm run copy-asset",
    "copy-asset": "node src/__scripts__/copy-command/copy-assets.script.mjs",
    "start:dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start:production": "cross-env NODE_ENV=production node dist/index.js",
    "ORM-typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "npm run ORM-typeorm -- migration:create -d ./src/shared/v1/database/core/data-source.ts",
    "migration:generate:dev": "cross-env NODE_ENV=development npm run ORM-typeorm -- migration:generate -d ./src/shared/v1/database/core/data-source.ts",
    "migration:generate:production": "cross-env NODE_ENV=production npm run ORM-typeorm -- migration:generate -d ./shared/v1/database/core/data-source.js",
    "migration:run:dev": "cross-env NODE_ENV=development npm run ORM-typeorm -- migration:run -d ./src/shared/v1/database/core/data-source.ts",
    "migration:run:production": "npm run ORM-typeorm -- migration:run -d ./shared/v1/database/core/data-source.js",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "npm:clean": "rimraf node_modules package-lock.json",
    "npm:reinstall": "npm run npm:clean && npm install",
    "npm:audit": "npm audit",
    "npm:audit:fix": "npm audit fix",
    "npm:check": "npm run npm:check:deps && npm run npm:check:types && npm run lint && npm run format:check",
    "npm:check:deps": "npm ls",
    "npm:check:types": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1037.0",
    "@maxmind/geoip2-node": "6.3.4",
    "@prisma/client": "7.8.0",
    "@prisma/extension-read-replicas": "0.5.0",
    "@swc/core": "1.15.33",
    "@types/hpp": "0.2.7",
    "amqplib": "1.0.3",
    "axios": "1.16.0",
    "bcryptjs": "3.0.3",
    "casbin": "5.50.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "date-fns-jalali": "4.4.0-0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.1",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.3",
    "melipayamak": "1.0.0",
    "multer": "2.1.1",
    "multer-s3": "3.0.1",
    "mysql2": "3.22.2",
    "node-cache": "5.1.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.29",
    "typeorm-adapter": "1.9.0",
    "ua-parser-js": "2.0.10",
    "uuid": "14.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.0",
    "@types/amqplib": "0.10.8",
    "@types/axios": "0.9.36",
    "@types/chalk": "0.4.31",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/eslint__js": "8.42.3",
    "@types/express": "5.0.6",
    "@types/hpp": "0.2.7",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.1.0",
    "@types/multer-s3": "3.0.3",
    "@types/mysql": "2.15.27",
    "@types/node": "25.6.2",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "chalk": "5.6.2",
    "child_process": "1.0.2",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "61.0.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "fs-extra": "11.3.4",
    "jest": "30.3.0",
    "jiti": "2.6.1",
    "lint-staged": "17.0.8",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "typeorm-extension": "3.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.10",
    "vite-plugin-node": "8.0.0",
    "vite-plugin-static-copy": "4.1.0"
  }
}
